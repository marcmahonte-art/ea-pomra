# ---------------------------------------------------------------------------
# Variables d'environnement — EA-POMRA (web)
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# ---------------------------------------------------------------------------

# URL publique absolue du site, sans barre oblique finale.
#
# Elle sert de base à trois choses :
#   - les URL absolues des cartes de partage social (Open Graph / Twitter) ;
#   - le lien canonique ;
#   - le plan du site (/sitemap.xml).
#
# Si elle est absente, le plan du site est vide et les cartes de partage
# n'ont pas d'URL exploitable. Sur Vercel, VERCEL_URL sert de repli
# automatique ; ailleurs, cette variable est indispensable.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.org

DATABASE_URL=postgresql://user:password@localhost:5432/ea_pomra
BACKOFFICE_SESSION_SECRET=change-this-to-a-long-random-secret
BACKOFFICE_DOCUMENT_ENCRYPTION_KEY=change-this-to-another-long-random-secret
BACKOFFICE_ALLOW_DEMO=false
PUBLIC_DEMO_MODE=false
BACKOFFICE_TRUSTED_PROXY_HEADERS=x-forwarded-for
BACKOFFICE_LOGIN_RATE_LIMIT=5
BACKOFFICE_LOGIN_RATE_WINDOW_SECONDS=900
BACKOFFICE_MUTATION_RATE_LIMIT=30
BACKOFFICE_MUTATION_RATE_WINDOW_SECONDS=60
BACKOFFICE_DOCUMENT_MAX_BYTES=10485760
BACKOFFICE_DB_POOL_MAX=10
BACKOFFICE_DB_IDLE_TIMEOUT_MS=30000
BACKOFFICE_DB_CONNECTION_TIMEOUT_MS=5000
BACKOFFICE_DB_QUERY_TIMEOUT_MS=15000
BACKOFFICE_DB_STATEMENT_TIMEOUT_MS=15000
BACKOFFICE_DB_LOCK_TIMEOUT_MS=5000
